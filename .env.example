# TripVault environment configuration
# Add real values in your local .env and Vercel Project Settings → Environment Variables.
# Publishable/anon key is intended for browser use when Row Level Security is enabled.
# Never use a Supabase service_role or secret key in VITE_ variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

VITE_APP_NAME=TripVault
VITE_DEFAULT_THEME=light
